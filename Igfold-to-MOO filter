#!/bin/bash
set -e

# --- Configuration & Inputs ---
REPRESENTATIVES_FASTA="final_5_10_representatives.fasta"
ANTIGEN_FASTA="antigen_target.fasta"
OUTPUT_DIR="./structural_screening_output"
mkdir -p "$OUTPUT_DIR"

# Read the antigen sequence into a variable for later multimer formatting
ANTIGEN_SEQ=$(tail -n +2 "$ANTIGEN_FASTA" | tr -d '\n\r ')

# --- Processing Loop for Each Clustered Representative ---
# This loop uses awk to extract individual fasta records dynamically
num_sequences=$(grep -c "^>" "$REPRESENTATIVES_FASTA")

for ((i=1; i<=num_sequences; i++)); do
    # Extract entry ID and sequence

    entry_header=$(awk -v seq_num="$i" 'BEGIN {RS=">"; FS="\n"} NR==seq_num+1 {print $1}' "$REPRESENTATIVES_FASTA" | awk '{print $1}')
    entry_seq=$(awk -v seq_num="$i" 'BEGIN {RS=">"; FS="\n"} NR==seq_num+1 {for(j=2;j<=NF;j++) printf "%s", $j; print ""}' "$REPRESENTATIVES_FASTA" | tr -d '\n\r ')
    
    echo "========================================================================="
    echo "Processing Representative $i/$num_sequences: ID = $entry_header"
    echo "========================================================================="
    
    # Create working directories for this specific candidate variant
    var_dir="${OUTPUT_DIR}/${entry_header}"
    mkdir -p "$var_dir/igfold" "$var_dir/af2_monomer" "$var_dir/af2_multimer"
    
    # Format a single-sequence temporary FASTA file
    echo ">${entry_header}" > "${var_dir}/temp_candidate.fasta"
    echo "$entry_seq" >> "${var_dir}/temp_candidate.fasta"

    # -------------------------------------------------------------------------
    # Stage 5A: Sub-second Coordinate Drafting (IgFold)
    # -------------------------------------------------------------------------
    echo "[Stage 5A] Generating rapid variable domain backbone with IgFold..."
    igfold \
      --seq_h "${var_dir}/temp_candidate.fasta" \
      --out_pdb "${var_dir}/igfold/${entry_header}_igfold.pdb"

    # -------------------------------------------------------------------------
    # Stage 5B: Standalone Antibody Refinement (AlphaFold 2 Monomer)
    # -------------------------------------------------------------------------
    echo "[Stage 5B] Refining antibody structure with standalone AlphaFold 2..."
    # Local ColabFold instance explicitly configured for standard monomer structure prediction
    colabfold_batch \
      --model-type alphafold2 \
      --num-models 3 \
      --num-recycle 3 \
      "${var_dir}/temp_candidate.fasta" \
      "${var_dir}/af2_monomer/"

    # Rename the top ranked PDB structure for clean pipeline inventory tracking
    mv "${var_dir}/af2_monomer/${entry_header}_unrelaxed_rank_001_"*.pdb "${var_dir}/af2_monomer/${entry_header}_af2_refined.pdb" 2>/dev/null || true

    # -------------------------------------------------------------------------
    # Stage 5C: Preliminary Complex Screening (AlphaFold 2 Multimer)
    # -------------------------------------------------------------------------
    echo "[Stage 5C] Building antigen-antibody complex input layout..."
    # Format the paired multimer fasta file using the custom colon separator notation
    # Format layout: >Complex_ID \n AntibodySequence:AntigenSequence
    echo ">${entry_header}_complex" > "${var_dir}/temp_multimer.fasta"
    echo "${entry_seq}:${ANTIGEN_SEQ}" >> "${var_dir}/temp_multimer.fasta"

    echo "[Stage 5C] Executing rigid-body docking layout screening via AF2-Multimer..."
    colabfold_batch \
      --model-type alphafold2_multimer_v3 \
      --num-models 3 \
      --num-recycle 3 \
      "${var_dir}/temp_multimer.fasta" \
      "${var_dir}/af2_multimer/"

    # Relocate top docked conformation to the root folder for next Rosetta steps
    mv "${var_dir}/af2_multimer/${entry_header}_complex_unrelaxed_rank_001_"*.pdb "${var_dir}/${entry_header}_docked_screening_complex.pdb" 2>/dev/null || true

    # Cleanup temporary configuration files
    rm -f "${var_dir}/temp_candidate.fasta" "${var_dir}/temp_multimer.fasta"

done

echo "Sequential Structural Architecture structural cascade successfully executed."
