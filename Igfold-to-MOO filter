#### Step 9: Multi-Objective Lead Selection (MOO Matrix Execution)
Balance binding metrics against manufacturing liabilities using a Multi-Objective Optimization selection script.

import pandas as pd
import numpy as np

# Load interface metrics and biophysical profiles
df_rosetta = pd.read_csv("interface_scores.txt", sep="\s+") # Contains dG_cross / packstat
df_biophys = pd.read_csv("biophysical_passed_variants.csv") # Contains CamSol score

# Combine metrics onto surviving variants
df_moo = df_rosetta.merge(df_biophys, on="id")

# Implement min-max feature scaling normalization functions
def min_max_normalize(series, invert=False):
    if invert:
        return (series.max() - series) / (series.max() - series.min())
    return (series - series.min()) / (series.max() - series.min())

# We want to minimize Rosetta dG (lower is stronger affinity) and maximize CamSol (higher is soluble)
df_moo['norm_affinity'] = min_max_normalize(df_moo['dG_cross'], invert=True)
df_moo['norm_solubility'] = min_max_normalize(df_moo['camsol'], invert=False)

# Compute Pareto Fitness Optimization Balance (Weighted 60% Affinity / 40% Solubility)
df_moo['Pareto_Fitness'] = (0.60 * df_moo['norm_affinity']) + (0.40 * df_moo['norm_solubility'])
df_leads = df_moo.sort_values(by="Pareto_Fitness", ascending=False)

# Export finalized structural lead candidates
df_leads.head(5).to_csv("FINAL_THERAPEUTIC_LEADS_MOO.csv", index=False)
print("Multi-Objective Lead optimization finished. Top functional sequences stored.")










