# Ensure paths are absolute or correctly formatted relative to execution location
echo "Indexing AlphaFold 3 structural models..."
find "$AF3_OUTPUT_DIR" -name "*.pdb" > "$STRUCT_DB_DIR/all_models_list.txt"

# 2. Build the MMseqs2 structural coordinate database 
# This parses the 3D atomic coordinates from the PDB files directly into binary formats
echo "Creating MMseqs2 3D structural database..."
mmseqs createdb \
  "$STRUCT_DB_DIR/all_models_list.txt" \
  "$STRUCT_DB_DIR/af3_models_db" \
  --dbtype 2  # Hardcodes database layout format type to expect 3D structures

# 3. Perform 3D Structural Spatial Clustering using TM-score
# Adjust metric constraints to define structural family boundaries
echo "Executing mmseqs cluster3d..."
mmseqs cluster3d \
  "$STRUCT_DB_DIR/af3_models_db" \
  "$STRUCT_DB_DIR/af3_structural_clusters" \
  "$STRUCT_DB_DIR/tmp_3d" \
  --min-seq-id 0.0 \
  --tmscore 0.80 \
  --tmscore-mode 1 \
  -c 0.80 \
  --cov-mode 0

# --- Parameters Explained ---
# --min-seq-id 0.0  -> Forces alignment decisions based strictly on 3D structure, ignoring sequence divergence
# --tmscore 0.80    -> Threshold to group shapes. A TM-score >0.80 means highly structural structural convergence.
# --tmscore-mode 1  -> Evaluates alignment based on the TM-score normalized by the shorter sequence length
# -c 0.80           -> Requires 80% coverage overlap across the structural interfaces

# 4. Extract Cluster Centers (The 5-10 dominant structural families that converged)
echo "Extracting representative models..."
mmseqs result2repseq \
  "$STRUCT_DB_DIR/af3_models_db" \
  "$STRUCT_DB_DIR/af3_structural_clusters" \
  "$STRUCT_DB_DIR/af3_representatives_db"

# 5. Export structural assignments to a human-readable TSV format
