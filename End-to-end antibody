Step 3: Combined Representation Analysis (R / ggplot2)
Import the computed multidimensional data coordinates back into R to overlay your statistical differential analysis data on the embedding layout.

library(ggplot2)
library(dplyr)

# Load your combined AntiBERTa2 + edgeR dataset
umap_data <- read.csv("antiberta2_umap_results.csv")

# Plot 1: Visualizing sequence geography colored by log-Fold Change (logFC)
# This lets you quickly see if enriched antibodies share high sequence/structural similarity
ggplot(umap_data, aes(x = UMAP_1, y = UMAP_2, color = logFC, size = -log10(FDR))) +
  geom_point(alpha = 0.8) +
  scale_color_gradient2(low = "blue", mid = "grey", high = "red", midpoint = 0) +
  theme_minimal() +
  labs(
    title = "AntiBERTa2 Representation Space",
    subtitle = "Points sized by edgeR significance, colored by logFC Expansion",
    x = "UMAP Dimension 1",
    y = "UMAP Dimension 2"
  )

# Plot 2: Overlaying traditional classifications onto the deep learning space
# This validates if AntiBERTa2 clusters correlate well with traditional V-Gene designations
ggplot(umap_data, aes(x = UMAP_1, y = UMAP_2, color = v_call)) +
  geom_point(alpha = 0.6, size = 2) +
  theme_minimal() +
  labs(
    title = "AntiBERTa2 Space Stratified by Germline V-Call",
    x = "UMAP Dimension 1",
    y = "UMAP Dimension 2"
  ) +
  theme(legend.position = "right")

