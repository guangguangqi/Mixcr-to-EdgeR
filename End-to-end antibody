######  Part 1: Bash Script (pipeline.sh)This script processes one example sample through the command-line tools. 
In production, you would run this in a loop or parallelize it across all your samples.bash

#!/bin/bash
set -e # Exit immediately if any command fails

# --- Configuration & Paths ---
SPECIES="human"
IGBLAST_DB_DIR="path/to/igblast/database"
IMGT_REF_FASTA="path/to/imgt_human_references.fasta"
THRESHOLD=0.15 # Nucleotide distance threshold from SHazaM analysis

# --- Step 1: MiXCR Assembly ---
echo "Running MiXCR Assembly..."
mixcr align -s hsa input_R1.fastq input_R2.fastq alignments.vdjca
mixcr assemble alignments.vdjca clones.clns

# Export consensus sequences (with clone sizes in header) for IgBLAST
mixcr exportClones -f clones.clns assembled_sequences.fasta

# --- Step 2: IgBLAST Annotation ---
echo "Running IgBLAST..."
igblastn \
  -germline_db_V "${IGBLAST_DB_DIR}/imgt_human_v" \
  -germline_db_D "${IGBLAST_DB_DIR}/imgt_human_d" \
  -germline_db_J "${IGBLAST_DB_DIR}/imgt_human_j" \
  -query assembled_sequences.fasta \
  -organism "${SPECIES}" \
  -domain_system imgt \
  -ig_seqtype Ig \
  -outfmt 19 \
  -out sample_igblast.tsv

# --- Step 3: Change-O Parsing & Clone Definition ---
echo "Parsing with Change-O..."
MakeDb.py igblast \
  -i sample_igblast.tsv \
  -s assembled_sequences.fasta \
  -r "${IMGT_REF_FASTA}" \
  -o sample_changeo.tsv

DefineClones.py bygroup \
  -d sample_changeo.tsv \
  --act set --sym min \
  --mode gene \
  --vcall V_CALL --jcall J_CALL --junction JUNCTION \
  --threshold ${THRESHOLD} \
  -o sample_clones.tsv

echo "Command-line steps complete. Files ready for R and MMseqs2."

#####  Part 2: R Script for Mutational & Lineage Analysis (lineage.R)
Run this on individual samples or subsets to analyze Somatic Hypermutation (SHM) and trace clone lineages.

library(alakazam)
library(shazam)
library(igraph)

# Load the clonal database generated by Change-O
db <- readChangeoDb("sample_clones.tsv")

# --- Step 4A: SHazaM Mutation Analysis ---
# Calculate targeted mutations (using standard human heavy chain model)
dist_matrix <- calcTargetingDistance(db, model="HShgV")

# --- Step 4B: Alakazam Lineage Trees ---
# Filter for a highly expanded clone of interest (e.g., Clone #42)
clone_data <- subset(db, CLONE == 42)

# Reconstruct phylogenetic tree graph using germline as the root
lineage_graph <- changeoToGraph(clone_data, germline="germline_alignment")

# Save or plot the tree topology
pdf("clone_42_lineage.pdf")
plot(lineage_graph, vertex.label=V(lineage_graph)$sequence_id, edge.arrow.size=0.3)
dev.off()

###### Part 3: Bash Script for Cross-Sample Clustering (clustering.sh)
Once you have processed all your individual samples, merge all their unique sequences into a single master FASTA (all_samples_unique_sequences.fasta) 
to cluster them into universal families.bash

#!/bin/bash
set -e

# --- Step 5: MMseqs2 Antibody Family Clustering ---
echo "Building MMseqs2 database..."
mmseqs createdb all_samples_unique_sequences.fasta master_seq_db

echo "Clustering sequences into structural families..."
# Groups sequences with >= 80% amino acid or nucleotide identity over the CDR3
mmseqs cluster master_seq_db cluster_db tmp_dir \
  --min-seq-id 0.8 \
  -c 0.8 \
  --cov-mode 0

echo "Exporting cluster assignments..."
mmseqs createtsv master_seq_db master_seq_db cluster_db family_assignments.tsv


####  Part 4: R Script for Differential Expression (differential_expression.R)
This final script counts how many MiXCR reads belong to each universal MMseqs2 family across your samples and finds significantly expanded groups.

library(edgeR)

# --- Step 6: Map Clusters to Counts Matrix ---
# Note: Your raw counts matrix should map MMseqs2 cluster IDs to original MiXCR read counts.
# Rows = MMseqs2 Family IDs, Columns = Sample Names
counts <- read.table("family_counts_matrix.tsv", header=TRUE, row.names=1, sep="\t")

# --- Step 7: Experimental Design Setup ---
# Example: 3 Controls vs 3 Treated Samples
conditions <- factor(c("Control", "Control", "Control", "Treated", "Treated", "Treated"))
design <- model.matrix(~conditions)

# --- Step 8: edgeR Statistical Modeling ---
dge <- DGEList(counts=counts, group=conditions)

# Remove low-abundance families that represent background sequencing noise
keep <- filterByExpr(dge, design)
dge <- dge[keep, , keep.lib.sizes=FALSE]

# TMM Normalization to correct for extreme immune clonal dominance/composition bias
dge <- calcNormFactors(dge, method="TMM")

# Estimate dispersion parameters using a Negative Binomial distribution
dge <- estimateDisp(dge, design)

# Fit the Quasi-Likelihood generalized linear model (strict error control)
fit <- glmQLFit(dge, design)
qlf <- glmQLFTest(fit, coef=2)

# Extract and export statistically expanded family candidates (FDR < 0.05)
top_families <- topTags(qlf, n=Inf, p.value=0.05)
write.csv(top_families$table, "significantly_expanded_families.csv")
print("Pipeline completely executed. Candidates exported.")


