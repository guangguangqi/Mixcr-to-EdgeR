Antiberta and Umap
#################################################################################################################
Step 1: Tokenization and Embedding Extraction (Python)
AntiBERTa2 utilizes a RoFormer (Rotary Position Embedding Transformer) backbone. 
The sequences must be formatted with spaces between individual amino acids. If you have paired chains, they must be separated by a [SEP] token

import torch
import numpy as np
import pandas as pd
import umap
from transformers import AutoTokenizer, AutoModel

# 1. Load your edgeR output containing the significantly expanded sequences
df = pd.read_csv("significantly_expanded_families.csv")

# Ensure you are using the full sequence (V-gene through J-gene, or CDR3)
# AntiBERTa2 requires spaces between individual amino acid letters
def format_sequence(seq):
    return " ".join(list(seq.upper()))

df['formatted_seq'] = df['amino_acid_sequence'].apply(format_sequence)

# 2. Initialize AntiBERTa2 from Hugging Face
model_name = "alchemab/antiberta2" # Or use "alchemab/antiberta2-cssp" for structural contrastive embeddings
tokenizer = AutoTokenizer.from_pretrained(model_name)
model = AutoModel.from_pretrained(model_name)

# Put model on GPU if available
device = torch.device("cuda" if torch.cuda.is_available() else "cpu")
model = model.to(device)
model.eval()

# 3. Extract continuous embeddings
embeddings_list = []

with torch.no_grad():
    for seq in df['formatted_seq']:
        # Tokenize inputs
        inputs = tokenizer(seq, return_tensors="pt", padding=True, truncation=True).to(device)
        outputs = model(**inputs)
        
        # Extract the hidden states of the last layer
        # outputs.last_hidden_state shape: [batch_size, sequence_length, embedding_dim]
        hidden_states = outputs.last_hidden_state
        
        # Generate a fixed-size vector per antibody by taking the mean across the sequence length dimension
        mean_embedding = torch.mean(hidden_states, dim=1).squeeze().cpu().numpy()
        embeddings_list.append(mean_embedding)

# Convert list to a clean numpy matrix (N_antibodies x 1024 embedding features)
embedding_matrix = np.array(embeddings_list)
np.save("antiberta2_embeddings.npy", embedding_matrix)

######################################################
Step 2: Dimension Reduction via UMAP (Python)
With high-dimensional features extracted (d=1024), compress them into a 2D coordinates map while preserving local and global structural similarities
# 4. Initialize and run UMAP
reducer = umap.UMAP(
    n_neighbors=15,     # Adjust to balance local clustering vs. global structure
    min_dist=0.1,       # Lower values create tightly packed clusters
    metric='cosine',    # Cosine distance is highly recommended for high-dimensional text/sequence embeddings
    random_state=42     # Seed for reproducible layout
)

umap_coordinates = reducer.fit_transform(embedding_matrix)

# 5. Append UMAP coordinates back to the statistical metadata
df['UMAP_1'] = umap_coordinates[:, 0]
df['UMAP_2'] = umap_coordinates[:, 1]

# Save comprehensive map data
df.to_csv("antiberta2_umap_results.csv", index=False)

